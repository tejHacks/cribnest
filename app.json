{
  "expo": {
    "name": "CribNest",
    "slug": "cribnest",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "cribnest",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.olateju.cribnest",
      "supportsTablet": true,
      "infoPlist": {}
    },
    "android": {
      "package": "com.olateju.cribnest",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#C026D3"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#C026D3",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 160
        }
      ],
      "expo-localization"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "3291e677-94e2-4c48-bd97-03c2fd190b0e"
      }
    },
    "owner": "tejcodes"
  }
}
